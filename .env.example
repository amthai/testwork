# Server-only credentials. Real values belong in ignored .env.local.
# Recommended mode for new installs. No automatic paid fallback.
PROOF_PROVIDER=deepseek
DEEPSEEK_API_KEY=
SPEECH_URL=http://127.0.0.1:8078
# Choose yandex for the conversational Denis voice. Only the server reads this key.
PROOF_TTS_PROVIDER=piper
YANDEX_SPEECHKIT_API_KEY=

# Used only with PROOF_PROVIDER=openai or to close an old OpenAI call.
OPENAI_API_KEY=
# Generate with npm run setup:access before a production launch.
PROOF_ACCESS_CODE=

# Local defaults
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATA_DIR=data
TRUST_PROXY_HOPS=0

OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_FEEDBACK_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MAX_SESSION_SECONDS=1800
MAX_DAILY_SESSIONS=30
MAX_OWNER_DAILY_SESSIONS=5
MAX_CONCURRENT_SESSIONS=3
RETENTION_DAYS=7
VITE_BASE_PATH=/
